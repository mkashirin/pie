{
    "$schema": "https://dprint.dev/schemas/v0.json",
    "indentWidth": 4,
    "useTabs": false,
    "lineWidth": 100,
    "newLineKind": "lf",
    "typescript": {
        "quoteStyle": "alwaysDouble",
        "arrowFunction.useParentheses": "force",
        "module.sortImportDeclarations": "maintain",
        "module.sortExportDeclarations": "maintain"
    },
    "json": {},
    "markdown": {
        "lineWidth": 99,
        "textWrap": "always",
        "codeBlock.skipFormat": true
    },
    "includes": [
        "README.md",
        "AGENTS.md",
        "docs/**/*.md",
        "skills/**/*.md",
        "package.json",
        "scripts/**/*.mjs",
        "tests/**/*.mjs"
    ],
    "excludes": [
        "**/node_modules",
        "**/.git",
        "**/package-lock.json"
    ],
    "plugins": [
        "https://plugins.dprint.dev/typescript-0.96.1.wasm",
        "https://plugins.dprint.dev/json-0.25.1.wasm",
        "https://plugins.dprint.dev/markdown-0.24.0.wasm"
    ]
}
