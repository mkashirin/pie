{
    "name": "pi-openai-multi",
    "version": "0.1.0",
    "private": true,
    "description": "Explicit per-session ChatGPT account selection for Pi 1.5",
    "keywords": ["pi-package"],
    "license": "MIT",
    "type": "module",
    "files": [
        "index.ts",
        "bridge.ts",
        "credentials.ts",
        "migration.ts",
        "oauth.ts",
        "vault.ts",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test tests/*.test.ts && node --test tests/*.test.mjs",
        "check": "npm run format:check && npm run typecheck && npm test",
        "format": "dprint fmt",
        "format:check": "dprint check"
    },
    "dependencies": { "@pi-extensions/tui": "0.1.0", "proper-lockfile": "^4.1.2" },
    "devDependencies": { "@types/proper-lockfile": "^4.1.4", "tsx": "^4.20.0" },
    "peerDependencies": {
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "engines": { "node": ">=22.19.0" },
    "pi": { "extensions": ["./index.ts"] }
}
