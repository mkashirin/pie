{
    "name": "pi-openai-web",
    "version": "0.1.0",
    "description": "Native OpenAI web search and safe public webpage reading for Pi",
    "keywords": ["pi-package"],
    "license": "MIT",
    "type": "module",
    "files": ["index.ts", "src", "README.md", "LICENSE"],
    "scripts": {
        "test": "node --test tests/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "format": "dprint fmt",
        "format:check": "dprint check",
        "check": "npm run format:check && npm run typecheck && npm test"
    },
    "dependencies": { "@pi-extensions/pi-kit": "0.1.0", "cheerio": "1.1.2", "ipaddr.js": "2.2.0" },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "engines": { "node": ">=22.19.0" },
    "pi": { "extensions": ["./index.ts"] }
}
