{
    "name": "pi-lsp",
    "version": "0.1.0",
    "description": "Source-native language server diagnostics and safe code actions for Pi",
    "keywords": [
        "pi-package"
    ],
    "license": "MIT",
    "type": "module",
    "files": [
        "index.ts",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "test": "node --test tests/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "format": "dprint fmt",
        "format:check": "dprint check",
        "check": "npm run format:check && npm run typecheck && npm test",
        "smoke": "node tests/smoke-run.mjs"
    },
    "dependencies": {
        "@pi-extensions/tui": "0.1.0",
        "cross-spawn": "7.0.6",
        "vscode-jsonrpc": "8.2.0",
        "vscode-languageserver-protocol": "3.17.5"
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "pi": {
        "extensions": [
            "./index.ts"
        ]
    }
}
