{
    "name": "pi-hem",
    "version": "0.1.0",
    "description": "Helix Editor Mode (HEM): a modal prompt editor for Pi",
    "keywords": [
        "pi-package",
        "pi",
        "helix",
        "editor",
        "modal"
    ],
    "license": "MIT",
    "type": "module",
    "files": [
        "index.ts",
        "src",
        "reference/resolved-arguments.ts",
        "README.md",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md"
    ],
    "scripts": {
        "format": "dprint fmt",
        "format:check": "dprint check",
        "test": "node --test tests/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "check": "npm run format:check && npm run typecheck && npm test",
        "prepack": "npm run check"
    },
    "dependencies": {
        "rregex": "1.13.5"
    },
    "peerDependencies": {
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "pi": {
        "extensions": [
            "./index.ts"
        ]
    }
}
