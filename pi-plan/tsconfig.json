{
    "compilerOptions": {
        "target": "ES2023",
        "lib": ["ES2023", "ES2023.Intl"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": ["index.ts", "src/**/*.ts", "src/**/*.js"]
}
